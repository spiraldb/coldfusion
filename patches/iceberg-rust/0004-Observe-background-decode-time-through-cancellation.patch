From cd721649bca0c479f9878640c9e4b644480c11ac Mon Sep 17 00:00:00 2001
From: Daniel King <dan@spiraldb.com>
Date: Sat, 7 Nov 2026 00:49:57 -0500
Subject: [PATCH 4/9] Observe background decode time through cancellation

Retains the native-reader changes from 1486e2b6eaa7accafd68eff325e84b3e74e9d04b.
The obsolete integration changes are omitted from this series.
---
 crates/iceberg/public-api.txt                 |  1 +
 crates/iceberg/src/arrow/reader/background.rs | 60 +++++++++++++++++--
 crates/iceberg/src/arrow/reader/mod.rs        | 16 +++++
 crates/iceberg/src/arrow/reader/pipeline.rs   |  9 ++-
 4 files changed, 79 insertions(+), 7 deletions(-)

diff --git a/crates/iceberg/public-api.txt b/crates/iceberg/public-api.txt
index 05079aa7..ac759012 100644
--- a/crates/iceberg/public-api.txt
+++ b/crates/iceberg/public-api.txt
@@ -74,6 +74,7 @@ pub fn iceberg::arrow::ArrowReaderBuilder::new(file_io: iceberg::io::FileIO, run
 pub fn iceberg::arrow::ArrowReaderBuilder::with_background_reads(self, background_reads: bool) -> Self
