From 2e4c372c2199206bcef28d75768f4a173cb1ca8d Mon Sep 17 00:00:00 2001
From: Daniel King <dan@spiraldb.com>
Date: Fri, 6 Nov 2026 14:55:50 -0500
Subject: [PATCH 18/22] Use canonical Arrow strings for DataFusion scans

---
 crates/integrations/datafusion/README.md      |  4 +--
 crates/integrations/datafusion/src/lib.rs     |  7 +++--
 crates/integrations/datafusion/src/scan.rs    |  1 -
 .../integrations/datafusion/tests/provider.rs | 27 +++++++++----------
 4 files changed, 17 insertions(+), 22 deletions(-)

diff --git a/crates/integrations/datafusion/README.md b/crates/integrations/datafusion/README.md
index 9f21d6263357ee90f4fcf274066e8c63cc79bd75..3dda8182ca046eda276f256c34461b7826d54660 100644
--- a/crates/integrations/datafusion/README.md
+++ b/crates/integrations/datafusion/README.md
@@ -22,8 +22,8 @@ fn context(table: Table) -> Result<SessionContext> {
 The caller keeps the table's Tokio runtime alive. A provider retains the loaded
 table's schema and snapshot; construct a new provider to observe catalog updates.
 
-Top-level string and binary columns use Arrow view arrays. Nested columns and
-extension storage keep their Iceberg Arrow types.
+String and binary columns use the canonical Iceberg Arrow types, `Utf8` and
+`LargeBinary`.
 
 Scans expose the session's target partition count, with a minimum of two. File
 byte ranges are balanced across consumers and own disjoint Parquet row groups.
diff --git a/crates/integrations/datafusion/src/lib.rs b/crates/integrations/datafusion/src/lib.rs
index 911dbdd9e4eed78bb483ccb3d70274873a7dc1de..ae6321576884228ba47de5634b09cbc867bdb906 100644
--- a/crates/integrations/datafusion/src/lib.rs
+++ b/crates/integrations/datafusion/src/lib.rs
@@ -29,7 +29,7 @@ use datafusion::common::stats::Precision;
 use datafusion::common::{DataFusionError, Result, Statistics};
 use datafusion::logical_expr::{Expr, TableProviderFilterPushDown, TableType};
 use datafusion::physical_plan::ExecutionPlan;
-use iceberg::arrow::{schema_to_arrow_schema, schema_with_view_types};
+use iceberg::arrow::schema_to_arrow_schema;
 use iceberg::table::Table;
 
 /// Exposes an immutable Iceberg table snapshot as parallel Parquet scans.
@@ -44,9 +44,8 @@ pub struct IcebergTableProvider {
 impl IcebergTableProvider {
     /// Creates a provider for the current schema and snapshot of `table`.
     pub fn try_new(table: Table) -> Result<Self> {
-        let schema = Arc::new(schema_with_view_types(
-            &schema_to_arrow_schema(table.metadata().current_schema()).map_err(external)?,
-        ));
+        let schema =
+            Arc::new(schema_to_arrow_schema(table.metadata().current_schema()).map_err(external)?);
         Ok(Self { table, schema })
     }
 }
diff --git a/crates/integrations/datafusion/src/scan.rs b/crates/integrations/datafusion/src/scan.rs
index b527592f218eb5fda99e867dcd010e0bfa410aa4..e17904e5af9f6c459b5e9425d5716274b1b3866a 100644
