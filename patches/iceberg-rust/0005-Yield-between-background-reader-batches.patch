From d412cf8de0e988072b1ca0ae24cfb57c7213190d Mon Sep 17 00:00:00 2001
From: Daniel King <dan@spiraldb.com>
Date: Sat, 7 Nov 2026 00:49:57 -0500
Subject: [PATCH 5/9] Yield between background reader batches

Retains the native-reader changes from 3a8a76c5849293722238789477b39e53adf41166.
The obsolete integration changes are omitted from this series.
---
 crates/iceberg/src/arrow/reader/background.rs | 1 +
 1 file changed, 1 insertion(+)

diff --git a/crates/iceberg/src/arrow/reader/background.rs b/crates/iceberg/src/arrow/reader/background.rs
index 9b93fdbd..9f2c0d91 100644
--- a/crates/iceberg/src/arrow/reader/background.rs
+++ b/crates/iceberg/src/arrow/reader/background.rs
@@ -62,6 +62,7 @@ pub(super) fn read_in_background(
             if sender.send(batch).await.is_err() || failed {
                 break;
             }
+            tokio::task::yield_now().await;
         }
     };
     let worker = runtime.cpu().spawn(Abortable::new(producer, registration));
