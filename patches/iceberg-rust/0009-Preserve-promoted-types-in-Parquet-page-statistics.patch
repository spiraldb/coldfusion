+    fn float_bound_to_datum(field_type: &PrimitiveType, val: f32) -> Datum {
+        match field_type {
+            PrimitiveType::Double => Datum::double(f64::from(val)),
+            _ => Datum::new(
+                field_type.clone(),
+                PrimitiveLiteral::Float(OrderedFloat::from(val)),
+            ),
+        }
+    }
