From 277fa34316e90e17efb38d318f71175900783f01 Mon Sep 17 00:00:00 2001
From: Daniel King <dan@spiraldb.com>
Date: Fri, 6 Nov 2026 15:14:49 -0500
Subject: [PATCH 20/22] Poll foreground Parquet reads with the configured IO
 driver

---
 crates/iceberg/src/arrow/reader/background.rs | 35 +++++++++++++++++--
 crates/iceberg/src/arrow/reader/mod.rs        |  4 ++-
 crates/iceberg/src/arrow/reader/pipeline.rs   |  2 +-
 3 files changed, 37 insertions(+), 4 deletions(-)

diff --git a/crates/iceberg/src/arrow/reader/background.rs b/crates/iceberg/src/arrow/reader/background.rs
index 9f2c0d9161d77c0d8509fdca91e4bded4e0e5a65..635046e9e4e41a55f268b0596c39cf10e3b0dbf1 100644
--- a/crates/iceberg/src/arrow/reader/background.rs
+++ b/crates/iceberg/src/arrow/reader/background.rs
@@ -27,10 +27,20 @@ use tokio::sync::mpsc;
 
 use super::ComputeTimeObserver;
 use crate::arrow::ScanMetrics;
-use crate::runtime::{JoinHandle, Runtime};
+use crate::runtime::{JoinHandle, Runtime, RuntimeHandle};
 use crate::scan::ArrowRecordBatchStream;
 use crate::{Error, ErrorKind, Result};
 
+pub(super) fn read_in_foreground(
+    mut input: ArrowRecordBatchStream,
+    io_runtime: RuntimeHandle,
+) -> ArrowRecordBatchStream {
+    Box::pin(futures::stream::poll_fn(move |cx| {
+        let _entered = io_runtime.enter();
+        input.poll_next_unpin(cx)
+    }))
+}
+
 pub(super) fn read_in_background(
     mut input: ArrowRecordBatchStream,
     runtime: &Runtime,
@@ -129,7 +139,7 @@ mod tests {
     use tokio::runtime::Builder;
     use tokio::sync::oneshot;
 
-    use super::read_in_background;
+    use super::{read_in_background, read_in_foreground};
     use crate::Runtime;
     use crate::arrow::ScanMetrics;
     use crate::scan::ArrowRecordBatchStream;
@@ -230,6 +240,27 @@ mod tests {
         );
     }
 
+    #[test]
+    fn foreground_reads_use_io_driver_on_compute_only_caller() {
+        let io = Builder::new_multi_thread()
+            .worker_threads(1)
+            .enable_all()
+            .build()
+            .unwrap();
+        let cpu = Builder::new_current_thread().build().unwrap();
+        let runtime = Runtime::new_with_split(&io, &cpu);
+        let caller = std::thread::current().id();
+        let input = stream::once(async move {
+            assert_eq!(std::thread::current().id(), caller);
+            tokio::time::sleep(Duration::from_millis(1)).await;
+            assert_eq!(std::thread::current().id(), caller);
+            Ok(batch())
+        });
+        let output = read_in_foreground(Box::pin(input), runtime.io().clone());
+        let batches: Vec<_> = cpu.block_on(output.try_collect()).unwrap();
+        assert_eq!(batches, vec![batch()]);
+    }
+
     #[test]
     fn background_reads_use_io_driver_from_compute_workers() {
         let io = Builder::new_current_thread().enable_all().build().unwrap();
diff --git a/crates/iceberg/src/arrow/reader/mod.rs b/crates/iceberg/src/arrow/reader/mod.rs
